  "cards": [
    {
      "dot": "cyan",
      "title": "Three layers",
      "items": [
        "raw/ holds sources; Claude reads them and is blocked from editing",
        "wiki/ is compiled and maintained by Claude",
        "mine/ holds your conclusions; Claude drafts into mine/drafts/ only"
      ]
    },
    {
      "dot": "emerald",
      "title": "Three operations",
      "items": [
        "Ingest: one source becomes a summary plus updated entity and concept pages",
        "Query: read the catalog first, answer with citations",
        "Lint: contradictions, uncited claims, orphans, gaps",
        "Each runs from its own input zone in inbox/"
      ]
    },
    {
      "dot": "rose",
      "title": "What keeps it honest",
      "items": [
        "Every wiki claim cites a file in raw/",
        "A wiki page never cites another wiki page as evidence",
        "Permission rules enforce the zones; manual approval elsewhere",
        "git history makes every change reviewable and reversible"
      ]
    }
  ]
